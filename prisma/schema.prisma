generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                String                  @id @default(uuid())
  email             String                  @unique
  fullName          String?
  masteryLevel      String                  @default("intermediate") // beginner | intermediate | advanced
  preferredLanguage String                  @default("English")
  preferredTeacherId String                 @default("elena")
  createdAt         DateTime                @default(now())
  
  lessons           Lesson[]
  conceptMastery    StudentConceptMastery[]
  documentChunks    CourseDocumentChunk[]
}

model Lesson {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  topic            String
  subjectCategory  String
  teacherId        String
  language         String
  estimatedMinutes Int      @default(15)
  modules          Json     // Array of speechScripts, blackboardVisuals, checkpoints
  createdAt        DateTime @default(now())
}

model StudentConceptMastery {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptName            String
  masteryScore           Float    @default(0.5) // 0.0 to 1.0
  identifiedMisconceptions String[]
  lastPracticedAt        DateTime @default(now())

  @@unique([userId, conceptName])
}

model CourseDocumentChunk {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentTitle String?
  chunkText     String
  
  // Requires pgvector extension in Postgres: CREATE EXTENSION IF NOT EXISTS vector;
  // Supported in Prisma via Unsupported
  embedding     Unsupported("vector(768)")?
}
